# Restock — variáveis de ambiente
# Copie para `.env` e preencha. `.env` NUNCA é commitado (regra 6).
# Os valores de SHOPIFY_* são gerados pelo `shopify app init` / Dev Dashboard.

# --- Shopify app (Dev Dashboard > seu app > API credentials) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Escopos mínimos da v1. Não pedir mais do que isso — a revisão da Shopify reprova excesso.
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations
SHOPIFY_APP_URL=https://localhost:3000

# --- Banco de dados ---
# Dev: SQLite. Produção: Postgres (Neon/Supabase free tier) — ver CUSTOS.md
DATABASE_URL="file:./dev.sqlite"
# DATABASE_URL="postgresql://user:senha@host/db?sslmode=require"

# --- Envio de e-mail do PO ao fornecedor (feature do plano Growth) ---
# Provedor previsto: Resend (free tier 3.000 e-mails/mês)
RESEND_API_KEY=
EMAIL_FROM="Restock <po@SEU-DOMINIO.com>"

# --- Monitoramento (antes de submeter) ---
SENTRY_DSN=

# --- Ambiente ---
NODE_ENV=development
